{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Agent 任务",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["E4301 是什么错误", "--local-model", "qwen2.5:7b-instruct"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "justMyCode": true,
      "python": "${workspaceFolder}/.venv/Scripts/python.exe"
    },
    {
      "name": "RAG 检索（不跑模型）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--kb-search", "E4301", "--kb-top-k", "5"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "justMyCode": true,
      "python": "${workspaceFolder}/.venv/Scripts/python.exe"
    },
    {
      "name": "HTTP 控制台",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--serve", "--port", "8787"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "justMyCode": true,
      "subProcess": false,
      "python": "${workspaceFolder}/.venv/Scripts/python.exe"
    },
    {
      "name": "离线演示（不联网）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["E4301 是什么错误", "--demo"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "justMyCode": true,
      "python": "${workspaceFolder}/.venv/Scripts/python.exe"
    }
  ]
}
